{
  "name": "clarify-kit",
  "version": "0.3.2",
  "description": "Turns a discussion into documents that settle it: build the documents, and check them against the facts they cite.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promptex-ai/clarify-kit.git",
    "directory": "packages/clarify-kit"
  },
  "bin": {
    "clarify-kit": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "fact-kit": "^0.13.0",
    "oxc-parser": "^0.155.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "fact-kit": "^0.13.0",
    "oxc-parser": "^0.155.0",
    "typescript": "7.1.0-beta",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "peerDependenciesMeta": {
    "oxc-parser": {
      "optional": true
    }
  }
}
